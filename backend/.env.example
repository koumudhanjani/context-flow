# =============================================================================
#  ContextFlow backend configuration
#  Copy this file to `backend/.env` and fill in your values. NEVER commit .env.
# =============================================================================

# --- Server ------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Load the embedding model in the background at startup (recommended)
WARMUP_ON_STARTUP=true

# --- Firebase auth verification ---------------------------------------------
# Your Firebase project ID (Firebase Console > Project settings > General)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Set to true in production so only signed-in users can call the API
AUTH_REQUIRED=false

# --- LLM providers (configure one or both) -----------------------------------
# Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=paste-your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Groq key: https://console.groq.com/keys
GROQ_API_KEY=paste-your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1024

# --- NLP ---------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# o200k_base = GPT-4o / GPT-4.1 tokenizer, cl100k_base = GPT-4 / GPT-3.5
TOKENIZER_ENCODING=o200k_base

# --- Limits ------------------------------------------------------------------
MAX_UPLOAD_MB=20
MAX_INPUT_CHARS=2000000
MAX_PDF_PAGES=500

