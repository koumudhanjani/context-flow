# =============================================================================
#  ContextFlow frontend configuration
#  Copy this file to `frontend/.env` and fill in your values. NEVER commit .env.
#  All values come from: Firebase Console > Project settings > General >
#  "Your apps" > Web app > SDK setup and configuration > Config
# =============================================================================

VITE_FIREBASE_API_KEY=paste-your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Backend URL. Leave empty in development (Vite proxies /api to localhost:8000).
# In production set it to your deployed API, e.g. https://contextflow-api.onrender.com
VITE_API_BASE_URL=

